# ---- Data -------------------------------------------------------------------------------------
# Everything under data/ is too large to commit (about 3.5 GB), rebuildable from code, or both.
# Kept: the READMEs, and each raw dataset's DESCRIPTION.md and pinned manifest.json (source, revision,
# licence and checksums), so a fresh clone knows exactly what to download.
data/**
!data/**/
!data/README.md
!data/*/README.md
!data/raw/*/DESCRIPTION.md
!data/raw/*/*/manifest.json

# Experiment outputs (regenerated by python -m experiments.mvp.run)
experiments/*/results/

# ---- Python -----------------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---- Secrets ----------------------------------------------------------------------------------
# API keys (GEMINI_API_KEY, JEV_API_KEY) belong in the environment, never in the repository.
.env
*.env
*.key

# ---- Editors and operating systems ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
